# =========================================================================
# M1 成交回執憑證（arblib/fee_receipts.py 讀這一份，不是 engine/.env）。
# 目的：把「費率表相信的數字」換成「交易所實際收的數字」。
#
# ★ 這裡只需要**唯讀**權限。M1 不下單——單是你手動下的，這支程式只讀回執。
#   建 key 時**不要勾提幣**，並綁 IP 白名單。
#
# 判準（LIVE_50U_SPEC M1）：與 fees.py 差 <0.5 bps 算 MATCH；
# 差更多就**以回執為準改 fees.py**，不是反過來。
# =========================================================================

# ---- 不需要任何金鑰的兩個（已幫你填好，都是公開識別碼）------------------
# HL 的 userFills 是公開的，用地址就查得到。
HL_ACCOUNT_ADDRESS=0x...
# Lighter 的帳號索引也是公開的。
LIGHTER_ACCOUNT_INDEX=

# ---- OKX（子帳戶＋只勾讀取＋IP 白名單）----------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---- Bitget（同上，也有 passphrase）-------------------------------------
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ---- Binance（沒有 passphrase）------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
